# Service Configuration
PORT=4000
NODE_ENV=development

# Target Handoff & Dispatch for Gargi's Diagnostic RCA Engine
# (Leave blank for internal in-memory direct function execution)
GARGI_RCA_WEBHOOK_URL=http://localhost:5000/api/rca/analyze

# AWS Credentials (Optional: if blank, simulator mode runs seamlessly)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS STS AssumeRole Configuration (Optional for cross-account enterprise scanning)
AWS_ROLE_ARN=
AWS_ROLE_EXTERNAL_ID=
AWS_ROLE_SESSION_NAME=ArchAutomationTelemetrySession
